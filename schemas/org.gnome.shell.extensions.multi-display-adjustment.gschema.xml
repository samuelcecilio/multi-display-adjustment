<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="multi-display-adjustment@cecilio.xyz">
  <schema id="org.gnome.shell.extensions.multi-display-adjustment"
          path="/org/gnome/shell/extensions/multi-display-adjustment/">
    <key name="group-displays" type="b">
      <default>false</default>
      <summary>Adjust all displays together</summary>
      <description>One brightness and one contrast slider apply the same level to every display.</description>
    </key>
    <key name="show-contrast" type="b">
      <default>true</default>
      <summary>Show contrast sliders</summary>
      <description>When disabled, only brightness sliders are shown.</description>
    </key>
  </schema>
</schemalist>
